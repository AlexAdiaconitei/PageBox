# Copy to .env and supply every blank secret before starting the stack.
# The application receives only its declared runtime variables from Compose.
# Set an exact image tag, e.g. 0.4.0. Compose refuses to start without one.
PAGEBOX_TAG=
PAGEBOX_ADMIN_HOST=pagebox.localhost
PAGEBOX_SITES_HOST=pages.localhost
PAGEBOX_PUBLIC_SCHEME=http
PAGEBOX_SITES_PREFIX=/s
PAGEBOX_REPLICAS=1

# Generate a hex database password so it can be embedded safely in a connection URL.
# openssl rand -hex 32
POSTGRES_PASSWORD=
# For Dokploy or a host process, supply a URL with a percent-encoded password.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Administrator credentials are used only by the storage service and provisioning.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Create a separate credential limited to the bucket before starting PageBox.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pagebox
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
PAGEBOX_ENSURE_BUCKET_ON_START=false

# Generate a unique signing key: openssl rand -base64 48
AUTH_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

PAGEBOX_DEFAULT_QUOTA_BYTES=5GB
# PAGEBOX_STORAGE_BYTES=500GB
# REDIS_URL=redis://valkey:6379
MAX_UPLOAD_BYTES=100MB
MAX_UPLOAD_TEMP_BYTES=400MB
MAX_CONCURRENT_UPLOADS=4
UPLOAD_BODY_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=600
MAX_UNCOMPRESSED_BYTES=500MB
MAX_FILES=20000
MAX_ZIP_RATIO=100
# Requests per IP and auth route, including successful sign-ins.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
API_KEY_MAX_REQUESTS=120
API_KEY_WINDOW_SECONDS=3600
PAGEBOX_MIGRATE_ON_START=true

# Use forwarded client addresses only when the app is reachable exclusively via a
# trusted proxy that replaces incoming forwarding headers. Count the actual proxy hops.
XFF_DEPTH=1
# Behind a trusted proxy, explicitly opt in after restricting direct app access:
# ADDRESS_HEADER=x-forwarded-for
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# These standalone backend ports are bound to 127.0.0.1 by Compose.
PAGEBOX_PORT=3000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
TRAEFIK_PORT=80
