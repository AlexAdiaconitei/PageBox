# Copy to .env and adjust. Everything without a default is required: the app refuses to
# start with an invalid configuration rather than starting half-configured.

# --- hosts -------------------------------------------------------------------
# MUST be two different hostnames. If they match, the process exits at startup: hosted
# static content would otherwise be able to call the admin API with the admin cookie
# attached (PLAN-static-hosting.md §D1).
PAGEBOX_ADMIN_HOST=pagebox.localhost
PAGEBOX_SITES_HOST=pages.localhost
PAGEBOX_SITES_PREFIX=/s
# Used to build absolute URLs behind a tunnel/proxy. Never derived from X-Forwarded-Proto.
PAGEBOX_PUBLIC_SCHEME=http
# More than one replica requires REDIS_URL (shared grant cache).
PAGEBOX_REPLICAS=1

# --- database ----------------------------------------------------------------
DATABASE_URL=postgres://pagebox:pagebox@postgres:5432/pagebox
DATABASE_POOL_MAX=10

# --- cache (optional) --------------------------------------------------------
# Empty = in-process cache, fine for a single replica.
# REDIS_URL=redis://valkey:6379

# --- object storage ----------------------------------------------------------
# MinIO (compose) or Garage; both need path-style addressing.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pagebox
S3_SECRET_KEY=pageboxpagebox
S3_BUCKET=pagebox
S3_FORCE_PATH_STYLE=true

# --- auth --------------------------------------------------------------------
# 32+ characters. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me
# First superadmin, created only while the instance has no users. The password is a
# first-login credential: it is stored with must_change_password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# --- limits ------------------------------------------------------------------
# 100 MB default because Cloudflare's proxy rejects larger request bodies on
# non-Enterprise plans, and that is the first deployment target. Raise it freely when
# nothing between the client and PageBox imposes a smaller cap (plain Traefik, LAN,
# Tailscale, a direct port). It also becomes adapter-node's BODY_SIZE_LIMIT.
MAX_UPLOAD_BYTES=104857600
MAX_UNCOMPRESSED_BYTES=524288000
MAX_FILES=20000
MAX_ZIP_RATIO=100

# --- credential throttling ---------------------------------------------------
# Failed sign-ins per window, counted per IP and per account. Successful sign-ins do not
# count. Raise the attempt count for a team that shares one public address.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# --- startup tasks -----------------------------------------------------------
PAGEBOX_MIGRATE_ON_START=true
PAGEBOX_ENSURE_BUCKET_ON_START=true

# --- compose-only knobs ------------------------------------------------------
POSTGRES_PASSWORD=pagebox
MINIO_ROOT_USER=pagebox
MINIO_ROOT_PASSWORD=pageboxpagebox
PAGEBOX_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
TRAEFIK_PORT=80

# --- v2 (§12), no effect in v1 -----------------------------------------------
PAGEBOX_BASE_DOMAIN=
PAGEBOX_SUBDOMAIN_MODE=false
