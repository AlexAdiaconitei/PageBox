# Overrides for running the app on the host (`pnpm dev`) against the compose services.
# Copy to .env.local — it is loaded after .env and wins.
#
# .env holds container hostnames, which only resolve inside the compose network. From the
# host, use the published ports instead (see docker-compose.yml).

DATABASE_URL=postgres://pagebox:pagebox@127.0.0.1:5432/pagebox
S3_ENDPOINT=http://127.0.0.1:9000

# The dev server listens on 5173, and PageBox routes by hostname, so open
#   http://pagebox.localhost:5173   (panel)
#   http://pages.localhost:5173     (sites)
# Anything else — including plain localhost — is answered with 404 on purpose.
PAGEBOX_PUBLIC_SCHEME=http
